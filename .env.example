DATABASE_URL=postgresql://postgres:postgres@localhost:5544/invoice_agent

# "anthropic" or "groq"
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Anthropic model id, e.g. claude-sonnet-5 -- or a Groq model id, e.g. llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

API_KEY=dev-key
MAX_REPAIR_ATTEMPTS=2
AUTO_APPROVE_MAX_AMOUNT=1000
MIN_CONFIDENCE=0.85
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
